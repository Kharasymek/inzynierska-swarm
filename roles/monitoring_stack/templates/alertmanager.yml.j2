global:
  resolve_timeout: 1m

route:
  receiver: "mailpit"
  group_by: ["alertname", "severity"]
  group_wait: 10s
  group_interval: 30s
  repeat_interval: 1h

receivers:
  - name: "mailpit"
    email_configs:
      - to: "{{ alertmanager_email_to }}"
        from: "{{ alertmanager_email_from }}"
        smarthost: "mailpit:1025"
        require_tls: false
        send_resolved: true