version: "3.8"

networks:
    monitoring_net:
        driver: overlay
        attachable: true
        ipam:
            config:
                - subnet: "{{ monitoring_network_subnet }}"

volumes:
  prometheus_primary_data:
  prometheus_secondary_data:

services:
  prometheus-primary:
    image: "{{ prometheus_image }}"
    user: "root"
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=7d"
      - "--storage.tsdb.retention.size=512MB"
      - "--web.enable-lifecycle"
    volumes:
      - "{{ monitoring_base_dir }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro"
      - "{{ monitoring_base_dir }}/prometheus/alerts.yml:/etc/prometheus/alerts.yml:ro"
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
      - "prometheus_primary_data:/prometheus"
    ports:
      - "9090:9090"
    networks:
      - monitoring_net
    deploy:
      replicas: 1
      placement:
        constraints:
          - "node.labels.monitoring == primary"
      restart_policy:
        condition: any
      resources:
        reservations:
          memory: 128M
        limits:
          memory: 384M

  prometheus-secondary:
    image: "{{ prometheus_image }}"
    user: "root"
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=7d"
      - "--storage.tsdb.retention.size=512MB"
      - "--web.enable-lifecycle"
    volumes:
      - "{{ monitoring_base_dir }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro"
      - "{{ monitoring_base_dir }}/prometheus/alerts.yml:/etc/prometheus/alerts.yml:ro"
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
      - "prometheus_secondary_data:/prometheus"
    ports:
      - "9091:9090"
    networks:
      - monitoring_net
    deploy:
      replicas: 1
      placement:
        constraints:
          - "node.labels.monitoring == secondary"
      restart_policy:
        condition: any
      resources:
        reservations:
          memory: 128M
        limits:
          memory: 384M

  node-exporter:
    image: "{{ node_exporter_image }}"
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/rootfs"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
    volumes:
      - "/proc:/host/proc:ro"
      - "/sys:/host/sys:ro"
      - "/:/rootfs:ro"
    networks:
      - monitoring_net
    deploy:
      mode: global
      labels:
        prometheus_job: "node-exporter"
        prometheus_port: "9100"
      restart_policy:
        condition: any
      resources:
        reservations:
          memory: 16M
        limits:
          memory: 64M

  cadvisor:
    image: "{{ cadvisor_image }}"
    command:
      - "--docker_only=true"
      - "--housekeeping_interval=15s"
      - "--disable_metrics=advtcp,cpu_topology,cpuset,hugetlb,memory_numa,process,referenced_memory,resctrl,sched,tcp,udp"
    volumes:
      - "/:/rootfs:ro"
      - "/var/run:/var/run:rw"
      - "/sys:/sys:ro"
      - "/var/lib/docker/:/var/lib/docker:ro"
      - "/dev/disk/:/dev/disk:ro"
    networks:
      - monitoring_net
    deploy:
      mode: global
      labels:
        prometheus_job: "cadvisor"
        prometheus_port: "8080"
      restart_policy:
        condition: any
      resources:
        reservations:
          memory: 32M
        limits:
          memory: 128M

  alertmanager:
    image: "{{ alertmanager_image }}"
    entrypoint:
      - /bin/sh
      - -c
      - |
        MY_IP=$$( (ip -4 addr show 2>/dev/null || ifconfig 2>/dev/null) | grep -oE '10\.10\.0\.[0-9]+' | head -n1 )
        exec /bin/alertmanager \
          --config.file=/etc/alertmanager/alertmanager.yml \
          --storage.path=/alertmanager \
          --cluster.listen-address=0.0.0.0:9094 \
          --cluster.advertise-address=$${MY_IP}:9094 \
          --cluster.peer=tasks.{{ monitoring_stack_name }}_alertmanager:9094
    volumes:
      - "{{ monitoring_base_dir }}/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro"
    ports:
      - "9093:9093"
    networks:
      - monitoring_net
    deploy:
      replicas: 2
      placement:
        max_replicas_per_node: 1
        constraints:
          - "node.role == manager"
      restart_policy:
        condition: any
      resources:
        reservations:
          memory: 24M
        limits:
          memory: 64M

  mailpit:
    image: "{{ mailpit_image }}"
    ports:
      - "8025:8025"
    networks:
      - monitoring_net
    deploy:
      replicas: 1
      placement:
        constraints:
          - "node.role == manager"
      restart_policy:
        condition: any
      resources:
        reservations:
          memory: 32M
        limits:
          memory: 64M

  grafana:
    image: "{{ grafana_image }}"
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_PATHS_PROVISIONING: "/etc/grafana/provisioning"
    volumes:
      - "{{ monitoring_base_dir }}/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro"
      - "{{ monitoring_base_dir }}/grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro"
    ports:
      - "3000:3000"
    networks:
      - monitoring_net
    deploy:
      replicas: 1
      placement:
        constraints:
          - "node.role == manager"
      restart_policy:
        condition: any
      resources:
        reservations:
          memory: 128M
        limits:
          memory: 320M